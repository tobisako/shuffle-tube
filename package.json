{
  "name": "shuffle-tube",
  "productName": "ShuffleTube",
  "version": "1.5.0",
  "description": "YouTube 動画の好きな区間（クリップ）だけを並べて連続再生するプレイリストアプリ。macOS / Windows（Electron）、スマホブラウザ。",
  "main": "./out/main/index.js",
  "author": "tobisako",
  "license": "MIT",
  "homepage": "https://github.com/tobisako/shuffle-tube#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobisako/shuffle-tube.git"
  },
  "bugs": {
    "url": "https://github.com/tobisako/shuffle-tube/issues"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --mac",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --mac --dir"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "zustand": "^5.0.15"
  }
}
